# Database. Leave empty for local development: an embedded PostgreSQL (PGlite)
# is created in .data/pglite automatically. On the server, point to PostgreSQL:
# DATABASE_URL=postgres://billions:PASSWORD@localhost:5432/billions
DATABASE_URL=

# Demo cars are inserted into an empty database in development. Set to "false" to disable,
# or "true" to also seed in production (e.g. the private test site).
# SEED_DEMO=

# Public URL of the site (used for canonical links and the sitemap)
SITE_URL=https://billions.am

# "true" while the site is private: adds noindex headers and a disallow-all robots.txt
SITE_NOINDEX=true

# Contact details shown on the site
NEXT_PUBLIC_PHONE=+374 00 000 000
NEXT_PUBLIC_WHATSAPP=37400000000
NEXT_PUBLIC_TELEGRAM=billions_am
NEXT_PUBLIC_EMAIL=info@billions.am
